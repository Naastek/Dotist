{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dotist",
  "version": "0.1.0",
  "identifier": "com.dotist.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "label": "main", "title": "Dotist", "width": 364, "height": 620, "minWidth": 320, "minHeight": 440, "decorations": false, "alwaysOnTop": true, "visibleOnAllWorkspaces": true, "resizable": true, "acceptFirstMouse": true, "transparent": true, "shadow": false, "windowEffects": { "effects": ["popover"], "state": "active", "radius": 16 } }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:" }
  },
  "bundle": { "externalBin": ["binaries/dotist-mcp"], "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"] }
}
